# Copia este archivo como ".env" (ese archivo real nunca se sube a GitHub).
PORT=3000

# Módulo 7 — Conexión a la base de datos MySQL.
# Si usas el MySQL local del iMac (puerto personalizado 3307):
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=tp_user
DB_PASSWORD=tp_password
DB_NAME=tp_integrador_db

# Módulo 8 — Autenticación con JWT.
# JWT_SECRET: clave para firmar los tokens. Usa un texto largo y difícil de adivinar.
# JWT_EXPIRES_IN: duración del token (ejemplos: 1h, 30m, 7d).
JWT_SECRET=cambia_esta_clave_por_una_larga_y_secreta
JWT_EXPIRES_IN=1h
